-- Layout-only patch for Toxic Air Redux. It deliberately leaves Toxic Air gameplay untouched.
-- Pin every update so the base mod's MCM callback can never restore its default position.
local function pin_to_bhs()
  if HUD and HUD.bg then
    HUD.bg:SetWndPos(vector2():set(15, 757))
  end
end

function on_game_start()
  RegisterScriptCallback("actor_on_update", pin_to_bhs)
end
